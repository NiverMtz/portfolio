{
  "rewrites": [
    {
      "source": "/watch",
      "destination": "/assets/cv.pdf"
    },
    {
      "source": "/download",
      "destination": "/assets/cv.pdf"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/download",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"resume_niver_martinez.pdf\""
        }
      ]
    }
  ]
}