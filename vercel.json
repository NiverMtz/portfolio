{
  "routes": [
    {
      "source": "/ver",
      "destination": "/assets/resume_niver_martinez.pdf"
    },
    {
      "source": "/bajar",
      "destination": "/assets/resume_niver_martinez.pdf"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/bajar",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"resume_niver_martinez.pdf\""
        }
      ]
    }
  ]
}