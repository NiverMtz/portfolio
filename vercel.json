{
  "routes": [
    {
      "source": "/",
      "destination": "/assets/resume_niver_martinez.pdf"
    },
    {
      "source": "/download",
      "destination": "/assets/resume_niver_martinez.pdf"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/download",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"resume_niver_martinez.pdf\""
        }
      ]
    }
  ]
}